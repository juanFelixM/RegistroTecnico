@page "/Ventas/Index"
@inject VentasServices ventasServices
@rendermode InteractiveServer

<PageTitle>Lista de Ventas</PageTitle>
<div class="container">
    <div class="card shadow-lg">
        <div class="card-header text-center bg-primary text-white">
            <h5 class="card-title text-center"> <strong>Consulta de Ventas</strong></h5>
        </div>

        <div class="card-body">

            <div class="d-flex justify-content-end mb-2">
                <a href="/Ventas/Create" class="btn btn-success">
                    <span class="bi bi-plus-square"></span> Crear
                </a>
            </div>

            @*labels*@

            <div class="row">
                @*Filtrar por*@
                <div class="col-3">
                    <label class="col-form-label"><strong>Filtrar por</strong></label>
                </div>

                @*ValorFiltro*@
                <div class="col-4">
                    <label class="col-form-label"><strong>B&uacute;squeda</strong></label>
                </div>
            </div>


            @*Inputs y botones*@
            <div class="row align-items-center">

                @*filtro*@
                <div class="col-3">
                    <InputSelect class="form-select" @bind-Value="Filtro">
                        <option value="" selected disabled>Elija una opci&oacute;n</option>
                        <option value="VentaId">Venta Id</option>
                        <option value="ClienteId">ClienteId</option>
                        <option value="Monto">Monto</option>
                    </InputSelect>
                </div>

                @*Busqueda*@
                <div class="col-4">
                    <div class="input-group">
                        <input class="form-control" @bind="ValorFiltro" placeholder="Buscar..." />
                        <button type="button" class="btn btn-outline-primary bi bi-search" @onclick="Buscar"> Search</button>
                    </div>
                </div>
            </div>

            <div class="row align-items-center">
                <div class="col-md-2">
                    <label class="form-label"><strong>Fecha Desde</strong></label>
                    <InputDate @bind-Value="FechaDesde" class="form-control form-control-sm" />
                </div>
                <div class="col-md-2">
                    <label class="form-label"><strong>Fecha Hasta</strong></label>
                    <InputDate @bind-Value="FechaHasta" class="form-control form-control-sm" />
                </div>
            </div>           
    

            <table class="table table-striped table-hover table-bordered mt-4">
                <thead class="table text-black">
                    <tr>

                        <th>Venta Id</th>
                        <th>Fecha</th>
                        <th>Cliente Id</th>
                        <th>Monto</th>

                        <th colspan="2" class="text-center">Editar</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var venta in listaVentas)
                    {
                        <tr>
                            @*Detalle*@
                            <td> @venta.VentaId</td>
                            <td> @venta.Fecha</td>
                            <td> @venta.ClienteId</td>
                            <td> @venta.Monto</td>
                            @*BTN Editar*@
                            <td class="text-center">
                                <a href="/Ventas/Edit/@venta.VentaId" class="btn btn-outline-primary bi bi-pencil-square"></a>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@code {
    List<Ventas> listaVentas = new();
    public string Filtro { get; set; } = string.Empty;
    public string ValorFiltro { get; set; } = string.Empty;
    public DateTime FechaDesde { get; set; }
    public DateTime FechaHasta { get; set; }

    protected override async Task OnInitializedAsync()
    {
        listaVentas = await ventasServices.Listar(c => c.VentaId > 0);
    }

    public async Task Buscar()
    {
        if (Filtro == "VentaId")
        {
            listaVentas = await ventasServices.Listar(s => s.VentaId == Convert.ToInt32(ValorFiltro));
        }
        else if (Filtro == "ClienteId")
        {
            listaVentas = await ventasServices.Listar(s => s.ClienteId.ToString().Contains(ValorFiltro));
        }
        else if (Filtro == "Monto")
        {
            listaVentas = await ventasServices.Listar(s => s.Monto == Convert.ToInt32(ValorFiltro));
        }
    }

    public async Task Eliminar(int id)
    {
        await ventasServices.Eliminar(id);
        listaVentas = await ventasServices.Listar(c => c.VentaId > 0);
    }
}